{
  "name": "opencode-token-board",
  "version": "0.2.0",
  "description": "Real-time token usage, cache analytics & performance dashboard plugin for OpenCode CLI",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "test:popup": "node ./scripts/test-popup.mjs",
    "release:check": "node ./scripts/publish-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "opencode-plugin",
    "tokens",
    "usage",
    "stats",
    "sqlite",
    "analytics",
    "tui"
  ],
  "license": "MIT",
  "author": "zhuzhutai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuzhutai/opencode-token-board.git"
  },
  "bugs": {
    "url": "https://github.com/zhuzhutai/opencode-token-board/issues"
  },
  "homepage": "https://github.com/zhuzhutai/opencode-token-board#readme",
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/core": "^0.2.9",
    "@opentui/keymap": "^0.2.9",
    "@opentui/solid": "^0.2.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
